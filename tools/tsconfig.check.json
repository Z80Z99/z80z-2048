{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2020"],
    "types": [],
    "baseUrl": "..",
    "paths": {
      "*": ["*"]
    }
  },
  "include": [
    "../core/**/*.ts",
    "../store/**/*.ts",
    "../types/**/*.ts",
    "../utils/**/*.ts",
    "shims.d.ts"
  ],
  "exclude": [
    "../node_modules",
    "../components",
    "../pages"
  ]
}
